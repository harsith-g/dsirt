# Copy to `.env` and edit before going live.
#   cp .env.example .env

# ----------------------------------------------------------------- general
ENVIRONMENT=development
DEBUG=false
BASE_URL=http://localhost:8080
HTTP_PORT=8080
HTTPS_PORT=8443

# --------------------------------------------------------------- database
POSTGRES_USER=exam
POSTGRES_PASSWORD=change-this-database-password
POSTGRES_DB=examportal
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Section 1 of the spec says max_overflow=40; section 6 says 10. 40 is the
# default here; set 10 to reproduce the stricter setting. Keep
# workers x (pool + overflow) below the server's max_connections (300).
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40

# ------------------------------------------------------------------ redis
REDIS_HOST=redis
REDIS_PORT=6379

# ------------------------------------------------------------------- auth
# REQUIRED IN PRODUCTION. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE-ME-dev-only-secret-key-please-override

CANDIDATE_TOKEN_MINUTES=360
ADMIN_TOKEN_MINUTES=480

# Set true once served over HTTPS, otherwise browsers drop the auth cookies.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --------------------------------------------------------------- seeding
SEED_ADMIN_EMAIL=admin@examportal.edu
SEED_ADMIN_PASSWORD=Admin@123
SEED_CANDIDATE_PASSWORD=dsirt@123

# ------------------------------------------------------------- proctoring
# Point these at the public host running coturn.
STUN_URL=stun:localhost:3478
TURN_URL=turn:localhost:3478
TURN_USERNAME=examportal
TURN_PASSWORD=turnsecret
HEARTBEAT_TTL_SECONDS=30
MAX_VIOLATIONS_BEFORE_FLAG=5

# ------------------------------------------------------------------- exam
DEFAULT_PHASE1_MINUTES=60
DEFAULT_PHASE2_MINUTES=60

# --------------------------------------------------------------- gunicorn
GUNICORN_WORKERS=4
LOG_LEVEL=info

# ------------------------------------------------------------------- tls
CERTBOT_DOMAIN=exam.example.edu
CERTBOT_EMAIL=admin@example.edu
