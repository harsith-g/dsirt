# ── Copy this file to .env and change the values ────────────────────────────
PORT=3000

# Long random string. Generate one with:  openssl rand -hex 32
EXAM_SECRET_KEY=change-me-to-a-long-random-string

# Admin login (the admin account always follows these two values)
ADMIN_EMAIL=admin@examportal.edu
ADMIN_PASSWORD=change-me-Strong@Password1

# Universal password for every candidate
CANDIDATE_DEFAULT_PASSWORD=dsirt@123

# Exam timing (minutes)
PHASE1_MINUTES=60
BREAK_MINUTES=15
PHASE2_MINUTES=60

# Questions per phase
EXAM_PAPER1_COUNT=50
EXAM_PAPER2_COUNT=50
